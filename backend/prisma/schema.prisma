generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model fooditem {
  id          Int               @id @default(autoincrement())
  name        String
  price       Float
  qty         Int               @default(1)
  a_status    fooditem_a_status @default(AVAILABLE)
  image       String?
  createdAt   DateTime          @default(now())
  category    String
  description String?
  orderitem   orderitem[]
}

model order {
  id         Int          @id @default(autoincrement())
  orderDate  DateTime     @default(now())
  totalAmt   Float
  status     order_status @default(INCART)
  customerId Int
  user       user         @relation(fields: [customerId], references: [id], map: "Order_customerId_fkey")
  orderitem  orderitem[]
  payment    payment[]
  token      token?

  @@index([customerId], map: "Order_customerId_fkey")
}

model orderitem {
  id       Int      @id @default(autoincrement())
  qty      Int
  price    Float
  orderId  Int
  foodId   Int
  fooditem fooditem @relation(fields: [foodId], references: [id], map: "OrderItem_foodId_fkey")
  order    order    @relation(fields: [orderId], references: [id], map: "OrderItem_orderId_fkey")

  @@index([foodId], map: "OrderItem_foodId_fkey")
  @@index([orderId], map: "OrderItem_orderId_fkey")
}

model payment {
  id      Int            @id @default(autoincrement())
  method  payment_method @default(COD)
  status  payment_status @default(PENDING)
  payDate DateTime       @default(now())
  orderId Int
  order   order          @relation(fields: [orderId], references: [id], map: "Payment_orderId_fkey")

  @@index([orderId], map: "Payment_orderId_fkey")
}

model token {
  id          Int          @id @default(autoincrement())
  tokenNumber Int
  tokenDate   DateTime     @default(now())
  status      token_status @default(PREPARING)
  createdAt   DateTime     @default(now())
  orderId     Int          @unique(map: "Token_orderId_key")
  order       order        @relation(fields: [orderId], references: [id], map: "Token_orderId_fkey")
}

model user {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique(map: "User_email_key")
  password  String
  role      user_role @default(CUSTOMER)
  createdAt DateTime  @default(now())
  order     order[]
}

enum payment_method {
  COD
  KHALTI
}

enum payment_status {
  PENDING
  PAID
  CANCELLED
  FAILED
}

enum order_status {
  INCART
  PROCESSING
  COMPLETED
  CANCELLED
}

enum token_status {
  PREPARING
  READY
  COLLECTED
  CANCELLED
}

enum fooditem_a_status {
  AVAILABLE
  UNAVAILABLE
  OUT_OF_STOCK
  DISCONTINUED
}

enum user_role {
  ADMIN
  CUSTOMER
}
